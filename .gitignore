# Build trees. The pattern covers every build directory this repository's own
# workflow creates (build, build-rel, build-dbg, build-asan, build/<id>), so an
# intermediate tree never appears as untracked work.
/build*/
/out/
/_build/
*.dir/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
*.cmake.stamp

# Visual Studio / MSBuild
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user

# Sanitizer / profiler output
*.san
*.asan
/lsan*.txt
/asan*.txt
*.pdb
*.ilk
*.exp
*.lib
*.obj
*.exe

# Local scratch
/tmp/
/scratch/
/fresh-clone/
/downstream-build/
/logs/
*.log
core
core.*
*.dmp
